# Mailpit defaults work without a .env file. Copy this file to .env to override.
API_HOST=127.0.0.1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Set true for an implicit TLS provider. Remote hosts otherwise require STARTTLS.
SMTP_SECURE=false
# Optional. Leave unset for automatic TLS defaults. Compose sets false for its private Mailpit service.
# SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_FROM=enquiries@example.test
ENQUIRY_TO=sales@example.test
